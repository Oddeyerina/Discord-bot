# Discord bot token from the developer portal.
DISCORD_TOKEN=
# Discord server ID managed by this dashboard.
DISCORD_GUILD_ID=
# Single dashboard admin username.
DASHBOARD_USER=admin
# Optional Discord user ID recorded as the dashboard actor in audit entries.
DASHBOARD_DISCORD_USER_ID=
# bcrypt hash of the dashboard admin password.
DASHBOARD_PASSWORD_HASH=
# Random secret for signed sessions and internal guild sync.
SESSION_SECRET=
# Shared SQLite database in the bind-mounted data directory.
DATABASE_URL=sqlite:////app/data/dcbot.db

# Host port that publishes the API container.
API_HOST_PORT=8080
# Host port that publishes the web container.
WEB_HOST_PORT=3001
# Internal bot-to-API URL; keep this service address.
API_BASE_URL=http://api:8000
# Exact URL the browser uses to reach the dashboard (protocol + host + port). Required for CORS + cookies. Must be updated at deploy time to the LXC IP and WEB_HOST_PORT.
WEB_ORIGIN=http://192.168.1.50:3001
# Browser-reachable API URL. Must be set to the LXC IP + API_HOST_PORT at deploy time. Rebuild the web image after changing this value.
NEXT_PUBLIC_API_BASE_URL=http://192.168.1.50:8080
# Set to 'true' only if the dashboard is served over HTTPS. Keep 'false' for plain HTTP in a home network.
COOKIE_SECURE=false
